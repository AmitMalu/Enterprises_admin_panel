    "@tiptap/pm": "^2.11.9",
    "@tiptap/react": "^2.11.9",
    "@tiptap/starter-kit": "^2.11.9",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.5.0",
    "embla-carousel-autoplay": "^7.1.0",
    "formik": "^2.4.6",
