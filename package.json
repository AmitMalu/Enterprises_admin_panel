  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
